/// Current composite risk score per asset. Not filtered by date.
table Mart_AssetRisk
	lineageTag: 56fe8c4b-098f-5b76-9064-faca245e3952

	column asset_id
		dataType: int64
		formatString: 0
		lineageTag: f360e686-d8ae-5017-80cb-50a6456e3304
		summarizeBy: none
		sourceColumn: asset_id

	column asset_name
		dataType: string
		lineageTag: de2c71ed-1dca-5e52-ad24-b82bba695b94
		summarizeBy: none
		sourceColumn: asset_name

	column asset_type
		dataType: string
		lineageTag: 66f76e80-bd1c-549f-aa5a-b633b1a8fbe1
		summarizeBy: none
		sourceColumn: asset_type

	column location_id
		dataType: int64
		formatString: 0
		lineageTag: 15c50b11-03ed-5287-88ca-a089beba3ddf
