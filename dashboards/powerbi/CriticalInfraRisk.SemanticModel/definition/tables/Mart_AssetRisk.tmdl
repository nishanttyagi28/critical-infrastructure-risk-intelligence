	partition Mart_AssetRisk = m
		mode: import
		source =
				let
				    Source = Csv.Document ( File.Contents ( DataFolder & "\Mart_AssetRisk.csv" ), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv] ),
				    Promoted = Table.PromoteHeaders ( Source, [PromoteAllScalars = true] ),
				    Typed = Table.TransformColumnTypes ( Promoted, {{"asset_id", Int64.Type}, {"asset_name", type text}, {"asset_type", type text}, {"location_id", Int64.Type}, {"region", type text}, {"city", type text}, {"latitude", type number}, {"longitude", type number}, {"age_years", Int64.Type}, {"failures_365d", Int64.Type}, {"weather_severity_30d", type number}, {"maintenance_365d", Int64.Type}, {"load_index", type number}, {"risk_score", type number}, {"risk_label", type text}}, "en-US" )
				in
				    Typed
