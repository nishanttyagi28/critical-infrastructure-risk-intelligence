	column latitude
		dataType: double
		dataCategory: Latitude
		lineageTag: 1c963e7b-0291-5eb4-815d-1aeec079b144
		summarizeBy: none
		sourceColumn: latitude

	column longitude
		dataType: double
		dataCategory: Longitude
		lineageTag: c4256f9a-4596-590e-bf60-d28912bf167e
		summarizeBy: none
		sourceColumn: longitude

	column age_years
		dataType: int64
		formatString: 0
		lineageTag: b4be4a2f-cda6-5348-97e7-fc960e20de50
		summarizeBy: sum
		sourceColumn: age_years

	column failures_365d
		dataType: int64
		formatString: 0
		lineageTag: 33a00876-41b7-53f4-b65c-18b2d9085986
