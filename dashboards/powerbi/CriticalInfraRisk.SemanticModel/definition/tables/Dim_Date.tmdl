/// Calendar, 1 Jan 2024 to 30 Jun 2025. Marked as the date table.
table Dim_Date
	lineageTag: 1d4a0f69-a708-5c8b-b05e-0178fc529cd8
	dataCategory: Time

	column date_key
		dataType: int64
		formatString: 0
		lineageTag: 7e9cec43-d49b-53dc-bfae-ebbd9e8bced3
		summarizeBy: none
		sourceColumn: date_key

	column full_date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: b86f7fad-c728-5988-a1b1-f6d99de0d85c
		summarizeBy: none
		sourceColumn: full_date

	column year
		dataType: int64
		formatString: 0
		lineageTag: c1f27928-fbab-5c9a-8afb-4ed45a0ba514
		summarizeBy: none
		sourceColumn: year

	column quarter
		dataType: int64
		formatString: 0
		lineageTag: 80c3d5fc-9d9f-5536-8c54-38ea4cd6a758
		summarizeBy: none
		sourceColumn: quarter

	column month
		dataType: int64
		formatString: 0
		lineageTag: fd6d0849-a9c5-546d-afae-d99aa3e2246b
		summarizeBy: none
		sourceColumn: month

	column month_name
		dataType: string
		lineageTag: 7788b662-df71-5d68-bb8b-7c4c21d4a824
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month

	column day
		dataType: int64
		formatString: 0
		lineageTag: c5789481-2dd3-59dc-a182-d09686d6a6a3
		summarizeBy: none
		sourceColumn: day

	column day_of_week
		dataType: int64
		formatString: 0
		lineageTag: a979aeaf-b1be-5ecc-aac5-fa651459ef0c
		summarizeBy: none
		sourceColumn: day_of_week

	column day_name
		dataType: string
		lineageTag: 7876d89d-8d6c-5013-9723-37ca03d1e90d
		summarizeBy: none
		sourceColumn: day_name
		sortByColumn: day_of_week

	column is_weekend
		dataType: int64
		formatString: 0
		lineageTag: 2547d399-4566-543f-a261-9879c9b0a5fa
		summarizeBy: none
		sourceColumn: is_weekend

	column iso_week
		dataType: int64
		formatString: 0
		lineageTag: 9da2b20c-f4a9-5341-a22e-af1657a7336a
		summarizeBy: none
		sourceColumn: iso_week

	column 'Year Month Key' = Dim_Date[year] * 100 + Dim_Date[month]
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 4b0c4bbd-9db2-5c34-86cd-ecabec9362d1
		summarizeBy: none

	column 'Year Month' = FORMAT ( Dim_Date[full_date], "mmm yyyy" )
		dataType: string
		lineageTag: 4669ad01-6301-51c9-9112-8300cc47d95a
		summarizeBy: none
		sortByColumn: 'Year Month Key'

	column 'Month Start' = DATE ( Dim_Date[year], Dim_Date[month], 1 )
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 0c8e0980-b3fd-5aca-97de-a35c52b1a75a
		summarizeBy: none

	partition Dim_Date = m
		mode: import
		source =
				let
				    Source = Csv.Document ( File.Contents ( DataFolder & "\Dim_Date.csv" ), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv] ),
				    Promoted = Table.PromoteHeaders ( Source, [PromoteAllScalars = true] ),
				    Typed = Table.TransformColumnTypes ( Promoted, {{"date_key", Int64.Type}, {"full_date", type date}, {"year", Int64.Type}, {"quarter", Int64.Type}, {"month", Int64.Type}, {"month_name", type text}, {"day", Int64.Type}, {"day_of_week", Int64.Type}, {"day_name", type text}, {"is_weekend", Int64.Type}, {"iso_week", Int64.Type}}, "en-US" )
				in
				    Typed
