# Leave DATABASE_URL unset to use the local SQLite warehouse.
# DATABASE_URL=postgresql+psycopg://ciri:ciri@localhost:5432/ciri

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Set to 1 to also log training runs to MLflow when that package is installed.
CIRI_MLFLOW=0
